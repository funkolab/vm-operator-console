{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["image", "auth", "service"],
  "properties": {
    "replicaCount": { "type": "integer", "minimum": 1 },
    "image": {
      "type": "object",
      "required": ["repository"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "watchNamespaces": { "type": "array", "items": { "type": "string" } },
    "basePath": { "type": "string", "pattern": "^(/[^/].*[^/]|/[^/]|)$" },
    "logLevel": { "enum": ["debug", "info", "warn", "error"] },
    "auth": {
      "type": "object",
      "properties": {
        "mode": { "enum": ["traefik", "dev", "none"] },
        "userHeader": { "type": "string", "minLength": 1 },
        "groupsHeader": { "type": "string", "minLength": 1 },
        "groupsSeparator": { "type": "string", "minLength": 1 },
        "extraGroups": { "type": "array", "items": { "type": "string" } },
        "trustedProxies": { "type": "array", "items": { "type": "string" } },
        "debug": { "type": "boolean" },
        "permissionsTTLSeconds": { "type": "integer", "minimum": 0 }
      }
    },
    "prismProxy": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "cacheTTLSeconds": { "type": "integer", "minimum": 0 },
        "requestTimeoutMs": { "type": "integer", "minimum": 100 }
      }
    },
    "rbac": {
      "type": "object",
      "properties": {
        "create": { "type": "boolean" },
        "readSecrets": { "type": "boolean" },
        "userRoles": { "type": "boolean" },
        "bindings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["namespace", "role"],
            "properties": {
              "namespace": { "type": "string" },
              "role": { "enum": ["viewer", "operator", "admin"] },
              "groups": { "type": "array", "items": { "type": "string" } },
              "users": { "type": "array", "items": { "type": "string" } }
            }
          }
        }
      }
    },
    "service": {
      "type": "object",
      "properties": {
        "type": { "enum": ["ClusterIP", "NodePort", "LoadBalancer"] },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
      }
    }
  }
}
